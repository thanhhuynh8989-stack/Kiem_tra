import { handleLoadStudentManagement } from './studentManagement.js';
import { handleLoadExamManagement } from './examManagement.js';
import { handleInitExamCreationUI } from './examCreation.js';
import { handleLoadLecturerManagement } from './lecturerManagement.js'; // 🔑 1. Bổ sung import module Quản lý Giảng viên
import { getLoggedInRole } from './authAndCore.js';

/**
 * HÀM CHUYỂN TAB VÀ ĐỒNG BỘ NẠP DỮ LIỆU CÁC GIAO DIỆN CHÍNH
 */
export function switchTab(tabId) {
  if (!tabId) return;

  // Chuẩn hóa tên tab (đảm bảo đồng bộ giữa các mã tab cũ và mới)
  let targetTab = tabId;
  if (tabId === 'LECTURER_MANAGEMENT') targetTab = 'tab-lecturers';
  if (tabId === 'STUDENT_MANAGEMENT') targetTab = 'tab-students';
  if (tabId === 'EXAM_MANAGEMENT') targetTab = 'tab-exams';

  // 🔑 2. CHẶN VÀ KIỂM TRA QUYỀN ADMIN KHI MỞ TAB QUẢN LÝ GIẢNG VIÊN
  if (targetTab === 'tab-lecturers') {
    const role = String(typeof getLoggedInRole === 'function' ? getLoggedInRole() : sessionStorage.getItem('userRole') || '').trim().toUpperCase();
    if (role !== 'ADMIN') {
      alert(`⚠️ Bạn không có quyền truy cập Quản Lý Giảng Viên! (Vai trò hiện tại: ${role || 'Chưa đăng nhập'})`);
      return;
    }
  }

  // 1. Cập nhật trạng thái tab active toàn cục
  window.currentActiveTab = targetTab;

  // 2. Cập nhật CSS Active trên Navigation Bar
  const navButtons = document.querySelectorAll('.nav-tab-btn, .nav-btn, [data-tab]');
  navButtons.forEach(btn => {
    const btnTab = btn.getAttribute('data-tab');
    const onclickAttr = btn.getAttribute('onclick') || '';
    
    if (btnTab === targetTab || onclickAttr.includes(targetTab)) {
      btn.classList.add('active');
      btn.style.background = '#2563eb';
      btn.style.color = '#ffffff';
    } else {
      btn.classList.remove('active');
      btn.style.background = 'transparent';
      btn.style.color = '#475569';
    }
  });

  // 🔑 3. BỔ SUNG 'tab-lecturers' VÀO KHU VỰC QUẢN LÝ CONTAINERS
  const tabContainers = {
    'tab-exams': document.getElementById('examManagementContainer') || document.getElementById('lecturerDashboardContainer'),
    'tab-students': document.getElementById('studentManagementContainer'),
    'tab-lecturers': document.getElementById('lecturerManagementContainer'), // 👈 ĐÃ BỔ SUNG CONTAINER NÀY
    'tab-create-exam': document.getElementById('examCreationContainer') || document.getElementById('examEditorContainer'),
    'tab-student-exams': document.getElementById('studentExamContainer')
  };

  Object.keys(tabContainers).forEach(key => {
    if (tabContainers[key]) {
      tabContainers[key].style.display = (key === targetTab) ? 'block' : 'none';
    }
  });

  // 🔑 4. BỔ SUNG CASE 'tab-lecturers' VÀO LOADER TỰ ĐỘNG
  switch (targetTab) {
    case 'tab-exams':
      if (typeof handleLoadExamManagement === 'function') handleLoadExamManagement();
      break;

    case 'tab-students':
      if (typeof handleLoadStudentManagement === 'function') handleLoadStudentManagement();
      break;

    case 'tab-lecturers': // 👈 ĐÃ BỔ SUNG XỬ LÝ CHO TAB GIẢNG VIÊN
      if (typeof handleLoadLecturerManagement === 'function') {
        handleLoadLecturerManagement();
      } else if (typeof window.handleLoadLecturerManagement === 'function') {
        window.handleLoadLecturerManagement();
      }
      break;

    case 'tab-create-exam':
      if (typeof handleInitExamCreationUI === 'function') handleInitExamCreationUI();
      break;

    case 'tab-student-exams':
      if (typeof window.handleLoadStudentDashboard === 'function') window.handleLoadStudentDashboard();
      break;
  }
}

/**
 * NÚT TẢI LẠI TRANG HIỆN TẠI (RELOAD CURRENT TAB)
 */
export function reloadCurrentTab() {
  const activeTab = window.currentActiveTab || 'tab-exams';
  switchTab(activeTab);
}

// BIND TO WINDOW
window.switchTab = switchTab;
window.reloadCurrentTab = reloadCurrentTab;