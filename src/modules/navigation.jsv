import { handleLoadStudentManagement } from './modules/studentManagement.js';
import { handleLoadExamManagement } from './modules/examManagement.js';
import { handleInitExamCreationUI } from './modules/examCreation.js';
import { handleLoadLecturerManagement } from './modules/lecturerManagement.js';
import { getLoggedInRole } from './modules/authAndCore.js';

export function switchTab(tabId) {
  console.group(`🔍 [DEBUG switchTab] Bắt đầu chuyển tới Tab: "${tabId}"`);
  
  if (!tabId) {
    console.warn('⚠️ [switchTab] tabId bị rỗng!');
    console.groupEnd();
    return;
  }

  let targetTab = tabId;
  if (tabId === 'LECTURER_MANAGEMENT') targetTab = 'tab-lecturers';
  if (tabId === 'STUDENT_MANAGEMENT') targetTab = 'tab-students';
  if (tabId === 'EXAM_MANAGEMENT') targetTab = 'tab-exams';

  console.log('📌 [switchTab] Target Tab sau khi chuẩn hóa:', targetTab);

  const role = String(typeof getLoggedInRole === 'function' ? getLoggedInRole() : sessionStorage.getItem('userRole') || '').trim().toUpperCase();
  console.log('👤 [switchTab] Role hiện tại của User:', role);

  if (targetTab === 'tab-lecturers') {
    if (role !== 'ADMIN') {
      console.warn(`⛔ [switchTab] Chặn truy cập! Role [${role}] không có quyền ADMIN.`);
      alert(`⚠️ Bạn không có quyền truy cập Quản Lý Giảng Viên! (Role: ${role || 'N/A'})`);
      console.groupEnd();
      return;
    }
  }

  window.currentActiveTab = targetTab;

  // 1. Ẩn TOÀN BỘ các container con trong <main> để chống tràn UI
  const mainArea = document.getElementById('mainContentArea') || document.querySelector('main');
  if (mainArea) {
    console.log(`🧹 [switchTab] Đang ẩn toàn bộ ${mainArea.children.length} phần tử con trong <main>`);
    Array.from(mainArea.children).forEach(child => {
      if (child.id !== 'loginCard') {
        child.style.display = 'none';
      }
    });
  } else {
    console.error('❌ [switchTab] KHÔNG TÌM THẤY <main id="mainContentArea">!');
  }

  // 2. Tìm Container tương ứng và hiển thị
  const targetContainerMap = {
    'tab-exams': document.getElementById('lecturerDashboardContainer') || document.getElementById('examManagementContainer'),
    'tab-students': document.getElementById('studentManagementContainer'),
    'tab-lecturers': document.getElementById('lecturerManagementContainer'),
    'tab-parser': document.getElementById('examEditorContainer') || document.getElementById('examParserContainer'),
    'tab-student-exams': document.getElementById('studentExamContainer')
  };

  const activeContainer = targetContainerMap[targetTab];
  console.log('📦 [switchTab] Target Container DOM:', activeContainer);

  if (activeContainer) {
    activeContainer.style.display = 'block';
    console.log(`✅ [switchTab] Đã bật display: block cho #${activeContainer.id}`);
  } else {
    console.error(`❌ [switchTab] KHÔNG TÌM THẤY CONTAINER DOM cho tab: ${targetTab}`);
  }

  // 3. Highlight nút trên Navbar
  const navButtons = document.querySelectorAll('.nav-tab-btn, .nav-btn, [data-tab]');
  navButtons.forEach(btn => {
    const btnTab = btn.getAttribute('data-tab');
    if (btnTab === targetTab) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
  });

  // 4. Gọi hàm nạp dữ liệu chạy ngầm
  console.log('🚀 [switchTab] Đang kích hoạt hàm nạp dữ liệu tương ứng...');
  switch (targetTab) {
    case 'tab-lecturers':
      if (typeof handleLoadLecturerManagement === 'function') {
        console.log('👉 [switchTab] Gọi handleLoadLecturerManagement() từ Import module thành công');
        handleLoadLecturerManagement();
      } else if (typeof window.handleLoadLecturerManagement === 'function') {
        console.log('👉 [switchTab] Gọi window.handleLoadLecturerManagement() từ Window scope thành công');
        window.handleLoadLecturerManagement();
      } else {
        console.error('❌ [switchTab] LỖI: Hàm handleLoadLecturerManagement KHÔNG TỒN TẠI!');
      }
      break;

    case 'tab-exams':
      if (typeof handleLoadExamManagement === 'function') handleLoadExamManagement();
      break;
    case 'tab-students':
      if (typeof handleLoadStudentManagement === 'function') handleLoadStudentManagement();
      break;
    case 'tab-parser':
      if (typeof handleInitExamCreationUI === 'function') handleInitExamCreationUI();
      break;
    case 'tab-student-exams':
      if (typeof window.handleLoadStudentDashboard === 'function') window.handleLoadStudentDashboard();
      break;
  }

  console.groupEnd();
}

// Bắt sự kiện Click toàn cục
document.addEventListener('click', (e) => {
  const targetBtn = e.target.closest('[data-tab]');
  if (targetBtn) {
    const tabId = targetBtn.getAttribute('data-tab');
    console.log('🖱️ [EventListener] Click nút tab:', tabId);
    if (tabId) {
      e.preventDefault();
      switchTab(tabId);
    }
  }
});

window.switchTab = switchTab;
